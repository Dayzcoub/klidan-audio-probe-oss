{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:klidan-audio-probe:device-configuration-profile:v3",
  "title": "KLIDAN Audio Probe Device Configuration Profile v3",
  "description": "Local exact Capture/Render pair evidence and advisory Probe-only recommendation. Never authorizes production AudioHost activation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "createdAtUtc", "probeVersion", "platform", "backend", "environment", "device", "endpointBindings", "capabilityEvidence", "evidence", "audioHostAssessments", "streamObservations", "duplexObservations", "recommendation", "privacy"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "profileId": { "type": "string", "format": "uuid" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "probeVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "const": "WINDOWS" },
    "backend": { "const": "WASAPI" },
    "environment": { "type": "object", "required": ["osDescription", "processArchitecture"] },
    "device": { "type": "object", "required": ["name", "manufacturer", "model", "driverVersion", "firmware", "hardwareClock", "usbMode"] },
    "endpointBindings": {
      "type": "object", "additionalProperties": false, "required": ["capture", "render"],
      "properties": {
        "capture": { "$ref": "#/$defs/endpointBinding" },
        "render": { "$ref": "#/$defs/endpointBinding" }
      }
    },
    "capabilityEvidence": {
      "type": "object", "additionalProperties": false, "required": ["capture", "render", "duplex"],
      "properties": { "capture": { "$ref": "#/$defs/uuidList" }, "render": { "$ref": "#/$defs/uuidList" }, "duplex": { "$ref": "#/$defs/uuidList" } }
    },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "object", "required": ["id", "sourceProvenance", "endpointDirection", "format", "duplex", "operationStatus"] } },
    "audioHostAssessments": { "type": "array", "maxItems": 8, "items": { "type": "object" } },
    "streamObservations": { "type": "array", "maxItems": 64 },
    "duplexObservations": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/duplexObservation" } },
    "recommendation": {
      "type": "object", "additionalProperties": false, "required": ["preferred", "fallback", "unavailableReasons", "scope", "confidence"],
      "properties": {
        "preferred": { "$ref": "#/$defs/choice" }, "fallback": { "$ref": "#/$defs/choice" },
        "unavailableReasons": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "scope": { "enum": ["NONE", "PROBE_PROVISIONAL"] },
        "confidence": { "enum": ["PROVISIONAL", "LOW", "NOT_AVAILABLE"] }
      }
    },
    "privacy": { "enum": ["LOCAL_MACHINE", "SANITIZED_PORTABLE"] }
  },
  "$defs": {
    "uuidList": { "type": "array", "uniqueItems": true, "maxItems": 1024, "items": { "type": "string", "format": "uuid" } },
    "endpointBinding": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["endpointId", "direction", "state", "friendlyName", "binding"],
      "properties": {
        "endpointId": { "type": ["string", "null"], "maxLength": 2048 },
        "direction": { "enum": ["CAPTURE", "RENDER"] }, "state": { "const": "ACTIVE" },
        "friendlyName": { "type": ["string", "null"], "maxLength": 256 },
        "binding": { "enum": ["LOCAL_EXACT", "SANITIZED_UNBOUND"] }
      }
    },
    "choice": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["mode", "format", "period", "evidence"],
      "properties": {
        "mode": { "enum": ["PROBE_PROVISIONAL"] },
        "format": { "type": "object", "required": ["encoding", "sampleRate", "channels", "containerBits", "validBits", "period"] },
        "period": { "enum": ["DEFAULT", "MINIMUM", null] },
        "evidence": { "$ref": "#/$defs/uuidList" }
      }
    },
    "duplexObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceId", "operationId", "captureEndpointId", "renderEndpointId", "period", "mmcss", "durationSeconds", "report"],
      "properties": {
        "evidenceId": { "type": "string", "format": "uuid" },
        "operationId": { "type": "string", "format": "uuid" },
        "captureEndpointId": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "renderEndpointId": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "period": { "enum": ["MINIMUM", "DEFAULT"] },
        "mmcss": { "enum": ["OFF", "PRO_AUDIO"] },
        "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "report": { "type": "object", "required": ["schemaVersion", "reportType", "operationId", "provenance", "requested", "capture", "render", "duplex"] }
      }
    }
  }
}
