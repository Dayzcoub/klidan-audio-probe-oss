{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klidan.example/schemas/wasapi-independent-render-event-diagnostic-v1.schema.json",
  "title": "Independent WASAPI Render EVENTCALLBACK diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reportType", "provenance", "buildCommit", "operationId", "timestampUtc",
    "endpointId", "direction", "shareMode", "eventMode", "audioEventType", "eventTimestampSource",
    "rateHz", "channels", "encoding", "mmcss", "renderPolicy", "durationSeconds",
    "requestedPeriod100ns", "requestedBufferDuration100ns", "requestedPeriodicity100ns", "requestedFrames",
    "defaultPeriod100ns", "minimumPeriod100ns", "actualBufferFrames", "actualBufferPeriod100ns", "prefillFrames",
    "eventCount", "bufferGetCount", "bufferReleaseCount", "framesProcessed", "expectedFrames",
    "frameCoveragePercent", "elapsedMilliseconds", "eventRateHz", "meanFramesPerEvent", "meanEventIntervalMilliseconds",
    "firstEventDelayMilliseconds", "eventIntervalMedianMilliseconds", "eventIntervalP95Milliseconds",
    "eventIntervalP99Milliseconds", "eventIntervalMaximumMilliseconds", "eventIntervalMaximumEndOffsetMilliseconds",
    "waitTimeoutCount", "apiHresults", "diagnosticDisposition", "audioQualityDisposition",
    "intervalPercentileMethod", "errorStage", "errorHresult", "cleanupState", "durationReached", "cancelled",
    "watchdogTimedOut", "deviceInvalidated", "clientReleased", "eventHandleClosed", "cancelEventClosed", "lastWaitStatus"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "reportType": {"const": "independent-wasapi-render-event-diagnostic-v1"},
    "provenance": {"const": "INDEPENDENT_WASAPI_RENDER_EVENT_DIAGNOSTIC"},
    "buildCommit": {"type": "string", "minLength": 1},
    "operationId": {"type": "string", "minLength": 1},
    "timestampUtc": {"type": "string", "format": "date-time"},
    "endpointId": {"const": "{0.0.0.00000000}.{ba4ca4cc-35d7-437a-b53b-99ffedc7e5b8}"},
    "direction": {"const": "RENDER"},
    "shareMode": {"const": "EXCLUSIVE"},
    "eventMode": {"const": "EVENTCALLBACK"},
    "audioEventType": {"const": "AUTO_RESET_NONSIGNALED"},
    "eventTimestampSource": {"const": "STEADY_CLOCK_IMMEDIATELY_AFTER_WAIT_RETURN"},
    "rateHz": {"const": 48000},
    "channels": {"const": 2},
    "encoding": {"const": "PCM16"},
    "mmcss": {"const": "OFF"},
    "renderPolicy": {"const": "SILENCE_ONLY"},
    "durationSeconds": {"const": 5},
    "requestedPeriod100ns": {"const": 30000},
    "requestedBufferDuration100ns": {"const": 30000},
    "requestedPeriodicity100ns": {"const": 30000},
    "requestedFrames": {"const": 144},
    "defaultPeriod100ns": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "minimumPeriod100ns": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "actualBufferFrames": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "actualBufferPeriod100ns": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "prefillFrames": {"type": "integer", "minimum": 0, "maximum": 144},
    "eventCount": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 4096}, {"type": "null"}]},
    "bufferGetCount": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 4096}, {"type": "null"}]},
    "bufferReleaseCount": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 4096}, {"type": "null"}]},
    "framesProcessed": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "expectedFrames": {"const": 240000},
    "frameCoveragePercent": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "elapsedMilliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "eventRateHz": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "meanFramesPerEvent": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "meanEventIntervalMilliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "firstEventDelayMilliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "eventIntervalMedianMilliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "eventIntervalP95Milliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "eventIntervalP99Milliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "eventIntervalMaximumMilliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "eventIntervalMaximumEndOffsetMilliseconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "waitTimeoutCount": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "apiHresults": {
      "type": "object", "additionalProperties": false,
      "required": ["comInitialize", "activate", "getDevicePeriod", "formatSupport", "initialize", "getBufferSize", "setEventHandle", "getRenderClient", "prefillGetBuffer", "prefillReleaseBuffer", "start", "stop", "eventClose", "cancelEventCreate", "cancelEventClose"],
      "properties": {
        "comInitialize": {"type": "string"}, "activate": {"type": "string"},
        "getDevicePeriod": {"type": "string"}, "formatSupport": {"type": "string"},
        "initialize": {"type": "string"}, "getBufferSize": {"type": "string"},
        "setEventHandle": {"type": "string"}, "getRenderClient": {"type": "string"},
        "prefillGetBuffer": {"type": "string"}, "prefillReleaseBuffer": {"type": "string"},
        "start": {"type": "string"}, "stop": {"type": "string"},
        "eventClose": {"type": "string"}, "cancelEventCreate": {"type": "string"}, "cancelEventClose": {"type": "string"}
      }
    },
    "diagnosticDisposition": {"enum": ["NOT_STARTED", "COMPLETED", "CANCELLED", "FAILED", "UNKNOWN"]},
    "audioQualityDisposition": {"const": "NOT_CLASSIFIED"},
    "intervalPercentileMethod": {"const": "MEDIAN_MIDPOINT;P95_P99_NEAREST_RANK"},
    "errorStage": {"type": "string"},
    "errorHresult": {"type": "string"},
    "cleanupState": {"enum": ["NOT_STARTED", "CONFIRMED", "CONFIRMED_NOT_STARTED", "UNKNOWN"]},
    "durationReached": {"type": "boolean"},
    "cancelled": {"type": "boolean"},
    "watchdogTimedOut": {"type": "boolean"},
    "deviceInvalidated": {"type": "boolean"},
    "clientReleased": {"type": "boolean"},
    "eventHandleClosed": {"type": "boolean"},
    "cancelEventClosed": {"type": "boolean"},
    "lastWaitStatus": {"enum": ["NOT_CALLED", "AUDIO_EVENT", "CANCEL_EVENT", "WAIT_TIMEOUT", "WAIT_FAILED"]}
  }
}
