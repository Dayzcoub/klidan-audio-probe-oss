<Window x:Class="KlidanAudioProbe.Gui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KlidanAudioProbe.Gui.Core;assembly=KlidanAudioProbe.Gui.Core"
        xmlns:local="clr-namespace:KlidanAudioProbe.Gui.App"
        xmlns:loc="clr-namespace:KlidanAudioProbe.Gui.App"
        Title="{local:Loc AppTitle}" Icon="/KlidanAudioProbe.Gui.App;component/application-icon.ico" Width="1440" Height="900" MinWidth="1024" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{StaticResource RootBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility"/>
    <local:DbfsProgressConverter x:Key="DbfsProgress"/>
    <local:FormatStatusConverter x:Key="FormatStatusText"/>
    <local:EventKindConverter x:Key="EventKindText"/>
    <local:SessionStateConverter x:Key="SessionStateText"/>
    <DataTemplate x:Key="MeterChannelTemplate" DataType="core:MeterChannelDto">
      <Border Width="76" Height="128" Background="{StaticResource TwoBrush}" CornerRadius="5" Padding="4" Margin="2" ToolTip="{Binding AccessibleText}" AutomationProperties.Name="{Binding AccessibleText}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding ChannelLabel}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Channel, StringFormat=Канал Windows {0}}"/>
          <Grid Grid.Row="1" Margin="3,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Orientation="Vertical" Minimum="0" Maximum="60" Value="{Binding PeakDbfs, Converter={StaticResource DbfsProgress}}" Foreground="{StaticResource SuccessBrush}" Background="{StaticResource RootBrush}" ToolTip="{Binding PeakText}"/>
            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="3,0"/>
            <ProgressBar Grid.Column="2" Orientation="Vertical" Minimum="0" Maximum="60" Value="{Binding RmsDbfs, Converter={StaticResource DbfsProgress}}" Foreground="{StaticResource SecondaryBrush}" Background="{StaticResource RootBrush}" ToolTip="{Binding RmsText}"/>
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding StateLabel}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryBrush}"/>
          <TextBlock Grid.Row="3" Text="{Binding LevelsCompactText}" FontSize="9" HorizontalAlignment="Center" ToolTip="{Binding AccessibleText}"/>
          <Grid Grid.Row="4" Margin="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PeakHoldText}" FontSize="9" Foreground="{StaticResource AmberBrush}" ToolTip="{Binding AccessibleText}"/>
            <TextBlock Grid.Column="1" Text="{Binding ClipsText, StringFormat=C{0}}" FontSize="9" Foreground="{StaticResource DangerBrush}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="EndpointTemplate" DataType="core:EndpointDto">
      <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding State}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
        <TextBlock Text="{Binding Format}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ReportTemplate" DataType="core:ReportDto">
      <StackPanel HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Mode}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
        <TextBlock Text="ДЕМО · Данные симуляции" Foreground="{StaticResource AmberBrush}" FontSize="12"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="EventTemplate" DataType="core:ProbeEventDto">
      <Grid Margin="0,3" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Sequence, StringFormat=№ {0}}" Foreground="{StaticResource SecondaryBrush}" FontFamily="Consolas"/>
        <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Kind, Converter={StaticResource EventKindText}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Text="{Binding Hresult}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/><TextBlock Text="{Binding SessionId, StringFormat=Сессия {0:D}}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="ДЕМО · Проверочные данные" Foreground="{StaticResource AmberBrush}" FontSize="11"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="InspectorSectionTemplate" DataType="core:InspectorSectionDto">
      <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Heading}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" Margin="0,0,0,5"/>
        <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate DataType="core:InspectorFieldDto">
          <Grid Margin="0,2" ToolTip="{Binding Tooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" Text="{Binding Value}" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="11" Padding="0" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Label}" Visibility="{Binding Copyable, Converter={StaticResource BoolVisibility}}"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding Copyable, Converter={StaticResource InverseBoolVisibility}}"/>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="OperatorDeviceStepButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkflowStep}" Value="{x:Static core:OperatorStep.Device}"><Setter Property="Background" Value="{StaticResource ThreeBrush}"/><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="OperatorTestStepButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkflowStep}" Value="{x:Static core:OperatorStep.Test}"><Setter Property="Background" Value="{StaticResource ThreeBrush}"/><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="OperatorResultStepButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding WorkflowStep}" Value="{x:Static core:OperatorStep.Result}"><Setter Property="Background" Value="{StaticResource ThreeBrush}"/><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{loc:Loc ProductName}" Foreground="{StaticResource AmberBrush}" FontWeight="Bold" FontSize="17"/><TextBlock Text="{loc:Loc ProductSuffix}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{loc:Loc WindowsDiagnosticsSuffix}" Foreground="{StaticResource MutedBrush}" Margin="12,2,0,0"/><TextBlock Text="{loc:Loc LanguageSelection}" Foreground="{StaticResource MutedBrush}" Margin="24,2,6,0" VerticalAlignment="Center"/><ComboBox x:Name="LanguageSelector" Width="156" MinWidth="156" Height="30" ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" ToolTip="{loc:Loc LanguageRestartNotice}" AutomationProperties.Name="{loc:Loc LanguageSelection}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc WindowControls}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="5"/><ColumnDefinition Width="42"/><ColumnDefinition Width="5"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource WindowChromeButton}" AutomationProperties.Name="{loc:Loc Minimize}" ToolTip="{loc:Loc Minimize}" Click="Minimize_Click"><Path Width="14" Height="14" Data="M 2,7 L 12,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/></Button>
          <Button Grid.Column="2" Style="{StaticResource WindowChromeButton}" AutomationProperties.Name="{loc:Loc MaximizeRestore}" ToolTip="{loc:Loc MaximizeRestore}" Click="Maximize_Click"><Path x:Name="MaximizeIcon" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2,2 L 12,2 12,12 2,12 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 6,2 L 12,2 12,8 M 9,5 L 3,5 3,12 9,12 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
          <Button Grid.Column="4" Style="{StaticResource WindowChromeButton}" AutomationProperties.Name="{loc:Loc Close}" ToolTip="{loc:Loc Close}" Click="Close_Click"><Path Width="14" Height="14" Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/></Button>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="292"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{loc:Loc CheckSection}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="12,10,0,7"/>
            <Button x:Name="OperatorDeviceStepButton" Style="{StaticResource OperatorDeviceStepButton}" Content="{loc:Loc DeviceStepLabel}" Command="{Binding OperatorStepCommand}" CommandParameter="Device"/>
            <Button x:Name="OperatorTestStepButton" Style="{StaticResource OperatorTestStepButton}" Content="{loc:Loc TestStepLabel}" Command="{Binding OperatorStepCommand}" CommandParameter="Test" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}"/>
            <Button x:Name="OperatorResultStepButton" Style="{StaticResource OperatorResultStepButton}" Content="{loc:Loc ResultStepLabel}" Command="{Binding OperatorStepCommand}" CommandParameter="Result" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}"/>
            <StackPanel Visibility="{Binding DeveloperToolsAvailable, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{loc:Loc DeveloperSection}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="12,20,0,7"/>
            <Button Style="{StaticResource NavButton}" Content="{loc:Loc DeveloperToolsNav}" Command="{Binding OpenDeveloperToolsCommand}"/>
            <StackPanel Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}">
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc LocalDevices}" Command="{Binding NavigateCommand}" CommandParameter="Devices"/>
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc LocalFormats}" Command="{Binding NavigateCommand}" CommandParameter="Formats"/>
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc CaptureDemo}" Command="{Binding NavigateCommand}" CommandParameter="Capture"/>
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc RenderDemo}" Command="{Binding NavigateCommand}" CommandParameter="Render"/>
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc EvidenceLibrary}" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc WorkerFakeIpc}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics"/>
              <Button Style="{StaticResource NavButton}" Content="{loc:Loc ManualRealOperations}" Command="{Binding OpenManualRealToolsCommand}"/>
              <Button Content="{loc:Loc ReturnToWindowsNav}" Command="{Binding CloseDeveloperToolsCommand}" Margin="4,8"/>
            </StackPanel></StackPanel>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Background="{StaticResource TwoBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0"><TextBlock Text="Windows diagnostics · только явные действия" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold" TextWrapping="Wrap"/></Border>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,22">
          <StackPanel x:Name="OperatorTestPanel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc TestSelectionTitle}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding OperatorSelectedDevice}" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{loc:Loc TestModeHeading}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
              <ComboBox x:Name="OperatorTestModeCombo" ItemsSource="{Binding OperatorTestModes}" SelectedValuePath="Value" SelectedValue="{Binding OperatorTestMode, Mode=TwoWay}" Margin="0,5,0,10" AutomationProperties.Name="{loc:Loc TestModeAccessible}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="{loc:Loc TestModeDescription}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}"/>
              <Border x:Name="InitializeQueryPrerequisiteNotice" Background="{StaticResource ThreeBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding NeedsInitializeFormatQuery, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{loc:Loc InitializeQueryPrerequisite}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/></Border>
              <TextBlock Text="{loc:Loc FutureCaptureMeter}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" Visibility="{Binding IsSelectedWindowsCapture, Converter={StaticResource BoolVisibility}}"/>
              <TextBlock Text="{loc:Loc FutureRenderTest}" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsSelectedWindowsRender, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" AutomationProperties.Name="{loc:Loc RealDuplexTest}">
              <StackPanel>
              <TextBlock Text="{loc:Loc DuplexTestTitle}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc DuplexPairDescription}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <WrapPanel><Button Content="{loc:Loc TestMinimum}" Command="{Binding RequestDuplexMinimumCommand}"/><Button Content="{loc:Loc TestDefault}" Command="{Binding RequestDuplexDefaultCommand}" Margin="8,0,0,0"/></WrapPanel>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding DuplexConsentPending, Converter={StaticResource BoolVisibility}}"><StackPanel>
                  <TextBlock Text="{loc:Loc DuplexNewConfirmation}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding DuplexConsentText}" TextWrapping="Wrap" Margin="0,4"/>
                  <CheckBox Content="{loc:Loc DuplexConsent}" IsChecked="{Binding DuplexConsentChecked, Mode=TwoWay}"/>
                  <WrapPanel><Button Content="{loc:Loc ConfirmAndStart}" Command="{Binding ConfirmDuplexValidationCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="{loc:Loc Cancel}" Command="{Binding CancelDuplexConsentCommand}" Margin="8,0,0,0"/></WrapPanel>
                </StackPanel></Border>
                <StackPanel Orientation="Horizontal" Visibility="{Binding DuplexValidationRunning, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"><TextBlock Text="{loc:Loc DuplexRunning}" VerticalAlignment="Center"/><Button Content="{loc:Loc StopBoth}" Command="{Binding CancelDuplexValidationCommand}" Margin="10,0,0,0"/></StackPanel>
                <TextBlock Text="{Binding DuplexStatus}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding DuplexRecommendationSummary}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding DuplexResultCards}" Margin="-4,4,-4,0" AutomationProperties.Name="{loc:Loc DuplexResultsAccessible}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="4" MinWidth="0"><StackPanel>
                    <TextBlock Text="{Binding Period}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                    <TextBlock Text="{Binding FinalStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3"/>
                    <TextBlock Text="{loc:Loc DuplexBuffers}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding BufferSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="Initialize · Capture / Render" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding InitializeSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="Start · Capture / Render" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding StartSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc DuplexFrames}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding FramesSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc DuplexCoverage}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding CoverageSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc DuplexQuality}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding QualitySummary}" TextWrapping="Wrap"/>
                    <Expander Header="{loc:Loc DuplexFaultDetails}" Margin="0,6,0,0"><StackPanel><TextBlock Text="Faults" FontWeight="SemiBold"/><TextBlock Text="{Binding Faults}" TextWrapping="Wrap"/><TextBlock Text="{loc:Loc ConcurrentTimeMs}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Runtime}"/><TextBlock Text="Stop / cleanup" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding StopsCleanup}" TextWrapping="Wrap"/><TextBlock Text="{loc:Loc ReportLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel></Expander>
                  </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{loc:Loc QueryParametersTitle}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{loc:Loc QueryChannelCountsLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/>
              <TextBox Text="{Binding RealQueryChannelCountsText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="240" AutomationProperties.Name="{loc:Loc QueryChannelCountsAccessible}"/>
              <Button Content="{loc:Loc RequestFormats}" Command="{Binding QueryRealFormatsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              <TextBlock Text="{Binding RealFormatMatrixStatus}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock x:Name="RealFormatSummaryText" Text="{Binding RealFormatSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.Name="{loc:Loc FormatResultsSummary}"/>
              <DataGrid x:Name="OperatorRealFormatGrid" ItemsSource="{Binding RealFormatRows}" SelectedItem="{Binding SelectedRealFormatRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" MinHeight="120" MaxHeight="300" EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{loc:Loc UniqueFormatResults}">
                <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc FormatColumn}" Binding="{Binding Format}" Width="*"/><DataGridTextColumn Header="{loc:Loc HertzColumn}" Binding="{Binding SampleRate}" Width="80"/><DataGridTextColumn Header="{loc:Loc ChannelsColumn}" Binding="{Binding Channels}" Width="60"/><DataGridTextColumn Header="{loc:Loc QueryStatusColumn}" Binding="{Binding DisplayStatus}" Width="190"/><DataGridTextColumn Header="HRESULT" Binding="{Binding SupportHresult}" Width="120"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{loc:Loc UniqueFormatDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              <TextBlock Text="{loc:Loc SelectSupportedFormat}" Foreground="{StaticResource SecondaryBrush}" Margin="0,10,0,4"/>
              <ComboBox x:Name="OperatorInitializePeriodCombo" ItemsSource="{Binding RealInitializePeriods}" SelectedValuePath="Value" SelectedValue="{Binding RealInitializePeriod, Mode=TwoWay}" MaxWidth="280" AutomationProperties.Name="{loc:Loc InitializePeriodAccessible}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="{Binding RealSelectedCandidateDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button x:Name="OperatorInitializeButton" Content="{loc:Loc CheckInitialization}" Command="{Binding RequestRealInitializeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <TextBlock x:Name="RealInitializeDisabledReasonText" Text="{Binding RealInitializeDisabledReason}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="{loc:Loc InitializeUnavailableReason}"/>
              <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding RealInitializeConsentPending, Converter={StaticResource BoolVisibility}}"><StackPanel>
                <TextBlock Text="{loc:Loc InitializeNewConfirmation}" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"/>
                <TextBlock Text="{Binding RealInitializeConsentText}" TextWrapping="Wrap" Margin="0,4"/>
                <CheckBox Content="{loc:Loc InitializeConsent}" IsChecked="{Binding RealInitializeConsentChecked, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal"><Button Content="{loc:Loc Confirm}" Command="{Binding ConfirmRealInitializeCommand}"/><Button Content="{loc:Loc Cancel}" Command="{Binding CancelRealInitializeCommand}" Margin="8,0"/></StackPanel>
              </StackPanel></Border>
            </StackPanel></Border>
            <StackPanel Orientation="Horizontal"><Button Content="{loc:Loc BackDevice}" Command="{Binding OperatorStepCommand}" CommandParameter="Device"/><Button Content="{loc:Loc ToResults}" Command="{Binding OperatorStepCommand}" CommandParameter="Result" Margin="8,0"/></StackPanel>
          </StackPanel>
          <StackPanel x:Name="AutomaticScanPanel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc AutomaticScanTitle}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding OperatorSelectedDevice}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{Binding AutomaticScanResultSummary}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding AutomaticScanStatus}" TextWrapping="Wrap" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding AutomaticScanCandidateSummary}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="{Binding AutomaticScanStagePlanText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding AutomaticScanProgressRows}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Stage}" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Action}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="{loc:Loc PhysicalRtlNotMeasured}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button Content="{loc:Loc StopRequestCancel}" Command="{Binding CancelAutomaticScanCommand}" Style="{StaticResource StopButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding AutomaticScanRunning, Converter={StaticResource BoolVisibility}}"/>
              <TextBlock Text="{loc:Loc CancellationPendingDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding AutomaticScanRunning, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel></Border>
            <WrapPanel Margin="0,12,0,0"><Button Content="{loc:Loc ToResult}" Command="{Binding OperatorStepCommand}" CommandParameter="Result" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanNavigateAwayFromAutomaticScan}"/><Button Content="{loc:Loc BackToDevice}" Command="{Binding OperatorStepCommand}" CommandParameter="Device" Margin="8,0,0,0" IsEnabled="{Binding CanNavigateAwayFromAutomaticScan}"/></WrapPanel>
          </StackPanel>
          <StackPanel x:Name="OperatorResultPanel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc ResultTitle}" FontSize="24" FontWeight="SemiBold"/>
            <Border Style="{StaticResource Card}" Visibility="{Binding HasAutomaticScanResult, Converter={StaticResource BoolVisibility}}"><StackPanel>
              <TextBlock Text="{Binding AutomaticScanResultProvenance}" Foreground="{StaticResource AmberBrush}" FontWeight="Bold"/>
              <TextBlock Text="{loc:Loc DeviceLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><TextBlock x:Name="AutomaticScanResultDeviceText" Text="{Binding AutomaticScanResultDevice}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:Loc ScanLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><TextBlock x:Name="AutomaticScanResultHeadlineText" Text="{Binding AutomaticScanResultHeadline}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="AutomaticScanRecommendationText" Text="{Binding AutomaticScanRecommendationText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock x:Name="AutomaticScanPersistenceText" Text="{Binding AutomaticScanPersistenceText}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" Margin="0,8,0,0"/>
              <Button Content="{loc:Loc OpenReportFolder}" Command="{Binding OpenAutomaticScanLocationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <Button x:Name="ExportAutomaticScanButton" Content="{loc:Loc ExportResults}" Command="{Binding ExportAutomaticScanCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
