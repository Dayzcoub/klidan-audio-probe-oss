                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button x:Name="ConfirmRealInitializeButton" Content="Подтвердить и проверить" Command="{Binding ConfirmRealInitializeCommand}"/><Button x:Name="CancelRealInitializeButton" Content="{loc:Loc Cancel}" Command="{Binding CancelRealInitializeCommand}" Margin="8,0,0,0"/></StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="RealInitializationDetailsText" Text="{Binding RealInitializationDetails}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
