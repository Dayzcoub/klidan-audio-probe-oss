            <Border Style="{StaticResource Card}" Margin="0,14,0,8"><StackPanel><TextBlock Text="{loc:Loc LocalDemoNoPipe}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Text="{loc:Loc LocalScenariosLimit}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal"><Button Content="{loc:Loc LocalDemoWarning}" Command="{Binding WarningCommand}"/><Button Content="{loc:Loc LocalDemoError}" Command="{Binding FailCommand}" Margin="8,0"/><Button Content="{loc:Loc LocalDemoDeviceLoss}" Command="{Binding DeviceLossCommand}"/><Button Content="{loc:Loc DisconnectLocalDemo}" Command="{Binding DisconnectCommand}" Margin="8,0"/></StackPanel><TextBlock Text="{Binding EmptyEventMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/><ListBox ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventTemplate}" MaxHeight="260" AutomationProperties.Name="{loc:Loc LocalDemoTimeline}"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border x:Name="Inspector" Grid.Column="2" Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
        <DockPanel><TextBlock x:Name="InspectorProvenance" DockPanel.Dock="Top" Text="{Binding InspectorProvenanceText}" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold" Margin="0,0,0,10"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding InspectorTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><ItemsControl x:Name="InspectorSectionList" ItemsSource="{Binding InspectorSections}" ItemTemplate="{StaticResource InspectorSectionTemplate}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="16,4" LastChildFill="False"><Button DockPanel.Dock="Right" Content="{loc:Loc StopWorker}" AutomationProperties.Name="{loc:Loc StopWorkerFakeSession}" Style="{StaticResource StopButton}" Width="130" Command="{Binding StopWorkerSessionCommand}" Visibility="{Binding WorkerOperationActive, Converter={StaticResource BoolVisibility}}"/><Button DockPanel.Dock="Right" Content="{loc:Loc StopLocal}" AutomationProperties.Name="{loc:Loc StopLocalDemoSession}" Style="{StaticResource StopButton}" Width="120" Command="{Binding StopCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{loc:Loc WindowsDiagnosticsExplicit}" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource InverseBoolVisibility}}"/><TextBlock Text="{loc:Loc DeveloperToolsDescription}" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}"/><TextBlock DockPanel.Dock="Right" Text="{Binding WorkerSession.Lifecycle, Converter={StaticResource SessionStateText}, TargetNullValue={loc:Loc NoFakeSession}}" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="12,0" AutomationProperties.Name="{loc:Loc WorkerFakeSessionState}" Visibility="{Binding WorkerStatusVisible, Converter={StaticResource BoolVisibility}}"/><TextBlock DockPanel.Dock="Right" Text="{loc:Loc FakeOnlyBadge}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}"/></DockPanel></Border>

    <Border Grid.RowSpan="3" Background="#CC0B1020" Visibility="{Binding ConfirmPending, Converter={StaticResource BoolVisibility}}"><Border Background="{StaticResource OneBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="{loc:Loc DemoSessionConfirmation}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfirmationText}" Foreground="{StaticResource SecondaryBrush}" Margin="0,12"/><CheckBox Content="{loc:Loc DemoSimulationConsent}" IsChecked="{Binding ConsentChecked}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Loc Cancel}" Command="{Binding CancelConfirmationCommand}"/><Button Content="{loc:Loc Confirm}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Border>
    <Border Grid.RowSpan="3" Background="#CC0B1020" Visibility="{Binding WorkerConsentPending, Converter={StaticResource BoolVisibility}}"><Border Background="{StaticResource OneBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="{loc:Loc WorkerFakeConfirmation}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkerConsentText}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="{loc:Loc WorkerFakeLimitations}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><CheckBox Content="{loc:Loc FakeSettingsConsent}" IsChecked="{Binding WorkerConsentChecked}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Loc Cancel}" Command="{Binding CancelWorkerConsentCommand}"/><Button Content="{loc:Loc ConfirmStartFake}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmWorkerSessionCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Border>
  </Grid>
</Window>
