              </StackPanel>
            </Border>
            <DataGrid ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="380" MaxHeight="560" AutomationProperties.Name="Матрица форматов">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Кодирование" Binding="{Binding Encoding}" Width="*" MinWidth="128"/>
                <DataGridTextColumn Header="Частота, Гц" Binding="{Binding SampleRate}" Width="110"/>
                <DataGridTextColumn Header="{loc:Loc ChannelsLabel}" Binding="{Binding ChannelCount}" Width="75"/>
                <DataGridTemplateColumn Header="Период: стандартный" Width="2*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DefaultPeriod.Status, Converter={StaticResource FormatStatusText}}" AutomationProperties.HelpText="{Binding DefaultPeriod.AccessibleText}" Foreground="{StaticResource TextBrush}" TextWrapping="NoWrap" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Период: минимальный" Width="2*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MinimumPeriod.Status, Converter={StaticResource FormatStatusText}}" AutomationProperties.HelpText="{Binding MinimumPeriod.AccessibleText}" Foreground="{StaticResource TextBrush}" TextWrapping="NoWrap" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Поддержка драйвером не означает Initialize, запуск потока или аудио-наблюдение." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
          </StackPanel>

          <StackPanel x:Name="CapturePanel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc CaptureChannelsTitle}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Измеритель Capture · только проверочные окна" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,18"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Метры каналов" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Peak · RMS · Hold · LOCAL DEMO" Foreground="{StaticResource MutedBrush}" Margin="0,3"/><TextBlock Text="{Binding MeterStatusText}" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,6"/><TextBlock Text="Банк каналов Capture" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding CaptureChannelBanks}" SelectedValuePath="Value" SelectedValue="{Binding CaptureChannelBank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Банк входных каналов"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ListBox ItemsSource="{Binding VisibleMeterChannels}" ItemTemplate="{StaticResource MeterChannelTemplate}" AutomationProperties.Name="Текущие уровни восьми каналов Capture" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Целостность потока" FontWeight="SemiBold"/><TextBlock Text="Состояние и качество потока показываются отдельно." Foreground="{StaticResource SecondaryBrush}" Margin="0,8,0,0"/><TextBlock Text="{Binding Session.Lifecycle, Converter={StaticResource SessionStateText}, TargetNullValue=Сессия не запускалась}"/><TextBlock Text="{Binding Session.Quality, Converter={StaticResource SessionStateText}, TargetNullValue=Качество неизвестно}"/><TextBlock Text="Покрытие и ошибки: неизвестно до получения данных сессии." Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <StackPanel Orientation="Horizontal"><Button Content="Начать симуляцию Capture" Style="{StaticResource PrimaryButton}" Command="{Binding BeginCommand}"/><Button Content="Следующее окно" Command="{Binding NextPulseCommand}" Margin="8,0"/></StackPanel>
          </StackPanel>

          <StackPanel x:Name="RenderPanel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc RenderChannelsTitle}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Проверка канала · симуляция без воспроизведения" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,18"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Настройки выхода · демо" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Банк каналов" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding RenderChannelBanks}" SelectedValuePath="Value" SelectedValue="{Binding RenderChannelBank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Банк каналов Windows"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Канал Windows" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding RenderChannelOptions}" SelectedValuePath="Value" SelectedValue="{Binding RenderChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Выбор канала Windows"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Длительность" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding DurationOptions}" SelectedValuePath="Value" SelectedValue="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Длительность демонстрации"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Сигнал: 997 Гц · не выше −36 dBFS · синус с паузами" Margin="0,16,0,0"/><TextBlock Text="Физическая маршрутизация: НЕИЗВЕСТНО" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><TextBlock Text="ДЕМО · Звук не воспроизводится." Foreground="{StaticResource AmberBrush}" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Физическое соответствие" FontWeight="SemiBold"/><TextBlock Text="UNKNOWN · физический выход не проверялся" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><TextBlock Text="Цифровая симуляция не подтверждает сигнал ЦАП или слышимость." Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,0"/></StackPanel></Border>
            <Button Content="Начать симуляцию Render" Style="{StaticResource PrimaryButton}" Command="{Binding BeginCommand}"/>
          </StackPanel>

          <StackPanel x:Name="ReportsPanel" Visibility="Collapsed">
            <DockPanel><TextBlock Text="Evidence Library" FontSize="24" FontWeight="SemiBold"/><Button Content="Обновить индекс" Command="{Binding RefreshEvidenceLibraryCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/></DockPanel>
            <TextBlock Text="Локальный rebuildable-индекс. Исторические записи read-only и не разрешают активные операции." Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <UniformGrid Columns="4" Margin="0,0,0,8"><TextBox Text="{Binding EvidenceLibraryDeviceFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Фильтр exact endpoint identity" Margin="0,0,6,0"/><TextBox Text="{Binding EvidenceLibraryTypeFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Фильтр report type" Margin="0,0,6,0"/><TextBox Text="{Binding EvidenceLibraryProvenanceFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="REAL или SYNTHETIC" Margin="0,0,6,0"/><ComboBox ItemsSource="{Binding EvidenceLibraryComparisonModes}" SelectedItem="{Binding EvidenceLibraryComparisonMode}" ToolTip="Режим сравнения" AutomationProperties.Name="Evidence comparison mode"/></UniformGrid>
            <TextBlock Text="{Binding EvidenceLibraryStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding EvidenceLibraryEntries}" SelectedItem="{Binding SelectedEvidenceLibraryEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="360" AutomationProperties.Name="Evidence Library records"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding ReportType}" Width="2*"/><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="*"/><DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="1.4*"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*"/><DataGridTextColumn Header="Local time" Binding="{Binding TimestampLocalText}" Width="1.4*"/><DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtcText}" Width="1.8*"/><DataGridTextColumn Header="Provenance" Binding="{Binding ProvenanceLabel}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Lifecycle / quality" Binding="{Binding Lifecycle}" Width="1.4*"/></DataGrid.Columns></DataGrid>
            <DataGrid ItemsSource="{Binding EvidenceLibraryComparisons}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Margin="0,8,0,0" AutomationProperties.Name="Normalized Duplex comparisons"><DataGrid.Columns><DataGridTextColumn Header="Configuration" Binding="{Binding ConfigurationKey}" Width="3*"/><DataGridTextColumn Header="Runs" Binding="{Binding TotalObservations}" Width="*"/><DataGridTextColumn Header="CLEAN" Binding="{Binding Clean}" Width="*"/><DataGridTextColumn Header="WARNINGS" Binding="{Binding Warnings}" Width="*"/><DataGridTextColumn Header="FAILED" Binding="{Binding Failed}" Width="*"/><DataGridTextColumn Header="UNKNOWN" Binding="{Binding Unknown}" Width="*"/><DataGridTextColumn Header="Capture coverage" Binding="{Binding CaptureCoverageMedian}" Width="1.5*"/><DataGridTextColumn Header="Render coverage" Binding="{Binding RenderCoverageMedian}" Width="1.5*"/><DataGridTextColumn Header="Capture P99" Binding="{Binding CaptureP99Median}" Width="1.2*"/><DataGridTextColumn Header="Render P99" Binding="{Binding RenderP99Median}" Width="1.2*"/></DataGrid.Columns></DataGrid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Историческая запись: observed evidence не равна current device state." Foreground="{StaticResource AmberBrush}"/><TextBlock Text="{Binding EvidenceLibraryDetails}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding EvidenceLibraryComparisonText}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,0"/><Button Content="Открыть оригинальный файл" Command="{Binding OpenEvidenceLibraryLocationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed">
            <TextBlock Text="Диагностика" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Фактические действия текущей синтетической модели" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,18"/>
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AmberBrush}" Margin="0,0,0,12"><StackPanel>
              <TextBlock Text="WORKER FAKE · реальный Named Pipe · без аудиоустройств" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"/>
              <TextBlock Text="{Binding WorkerState.Message}" AutomationProperties.Name="Состояние Native Worker" TextWrapping="Wrap" Margin="0,8"/>
              <StackPanel Orientation="Horizontal"><Button Content="Запустить worker fake" Command="{Binding ConnectWorkerCommand}"/><Button Content="Запросить синтетические устройства" Command="{Binding QueryWorkerEndpointsCommand}" Margin="8,0"/><Button Content="Завершить worker" Command="{Binding ShutdownWorkerCommand}"/></StackPanel>
              <TextBlock Text="Удалённые ответы WORKER FAKE" Foreground="{StaticResource SecondaryBrush}" Margin="0,10,0,4" Visibility="{Binding WorkerCurrentEndpointsVisible, Converter={StaticResource BoolVisibility}}"/>
              <ComboBox ItemsSource="{Binding WorkerEndpoints}" SelectedItem="{Binding SelectedWorkerEndpoint, Mode=TwoWay}" AutomationProperties.Name="Синтетическое устройство worker" Visibility="{Binding WorkerCurrentEndpointsVisible, Converter={StaticResource BoolVisibility}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="Последний ответ отключённого worker" Foreground="{StaticResource AmberBrush}" Margin="0,10,0,4" Visibility="{Binding HasHistoricalWorkerEndpoints, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Исторический ответ отключённого worker"/>
              <ItemsControl ItemsSource="{Binding HistoricalWorkerEndpointNames}" Visibility="{Binding HasHistoricalWorkerEndpoints, Converter={StaticResource BoolVisibility}}"/>
              <TextBlock Text="{Binding WorkerRestartExplanation}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock Text="Формат и топология этого формата" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
              <ComboBox ItemsSource="{Binding WorkerFormatOptions}" SelectedItem="{Binding SelectedWorkerFormat, Mode=TwoWay}" AutomationProperties.Name="Формат синтетического потока" Visibility="{Binding WorkerCurrentEndpointsVisible, Converter={StaticResource BoolVisibility}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FormatId}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock x:Name="WorkerChannelCountText" Text="{Binding WorkerChannelSummary}" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,4" AutomationProperties.Name="Топология и число каналов выбранного worker формата"/>
              <StackPanel Visibility="{Binding WorkerRenderChannelVisible, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="Канал Windows для Render" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
                <ComboBox ItemsSource="{Binding WorkerRenderChannelOptions}" SelectedValuePath="Value" SelectedValue="{Binding WorkerRenderChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Канал Windows для сессии Render"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </StackPanel>
              <Grid x:Name="WorkerFakeSettingsGrid" Margin="0,8,0,0" Loaded="WorkerFakeSettingsGrid_Loaded" SizeChanged="WorkerFakeSettingsGrid_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="WorkerDurationSetting" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Длительность" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><ComboBox MinWidth="160" ItemsSource="{Binding DurationOptions}" SelectedValuePath="Value" SelectedValue="{Binding WorkerDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Длительность worker fake"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel x:Name="WorkerPeriodSetting" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="{loc:Loc PeriodLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><ComboBox MinWidth="160" ItemsSource="{Binding WorkerPeriodOptions}" SelectedValuePath="Value" SelectedValue="{Binding WorkerPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Период worker fake"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel x:Name="WorkerMmcssSetting" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="MMCSS" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><ComboBox MinWidth="160" ItemsSource="{Binding WorkerMmcssOptions}" SelectedValuePath="Value" SelectedValue="{Binding WorkerMmcss, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MMCSS worker fake"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel x:Name="WorkerScenarioSetting" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Сценарий" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><ComboBox MinWidth="160" ItemsSource="{Binding WorkerScenarioOptions}" SelectedValuePath="Value" SelectedValue="{Binding WorkerScenario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Сценарий worker fake"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Запросить Capture" Style="{StaticResource PrimaryButton}" Command="{Binding RequestWorkerCaptureCommand}"/><Button Content="Запросить Render" Style="{StaticResource PrimaryButton}" Command="{Binding RequestWorkerRenderCommand}" Margin="8,0"/><Button Content="СТОП WORKER" Style="{StaticResource StopButton}" Command="{Binding StopWorkerSessionCommand}"/></StackPanel>
              <TextBlock Text="{Binding WorkerNotice}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock Text="Настройки активной fake-сессии неизменяемы:" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="{Binding WorkerSessionSettingsText}" AutomationProperties.Name="Неизменяемые настройки сессии worker" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="Физическое соответствие каналам: UNKNOWN · PCM не генерируется и устройства не активируются." Foreground="{StaticResource AmberBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding WorkerMeterVisible, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding WorkerMeterHeading}" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{Binding WorkerMeterFormatSummary}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,2"/>
                <TextBlock Text="{Binding WorkerMeterSnapshotSummary}" Foreground="{StaticResource SecondaryBrush}"/>
                <TextBlock Text="{Binding WorkerMeterCoalescingSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="Физическая маршрутизация: неизвестно" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding WorkerMeterStatusText}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,3,0,6"/>
                <ComboBox ItemsSource="{Binding WorkerMeterBanks}" SelectedValuePath="Value" SelectedValue="{Binding WorkerMeterBank, Mode=TwoWay}" AutomationProperties.Name="Банк каналов измерителя worker"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <ListBox x:Name="WorkerMeterBankList" ItemsSource="{Binding WorkerVisibleMeterChannels}" ItemTemplate="{StaticResource MeterChannelTemplate}" Margin="0,4,0,0" AutomationProperties.Name="Банк из восьми каналов worker" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
              </StackPanel>
            </Border>
            <TextBlock Text="{loc:Loc WorkerEventsTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding WorkerEmptyTimelineText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <DataGrid x:Name="WorkerTimelineGrid" ItemsSource="{Binding WorkerTimeline}" SelectedItem="{Binding SelectedWorkerTimelineEntry, Mode=TwoWay}" MaxHeight="280" MinHeight="120" RowHeight="30" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Журнал событий worker fake"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="MinHeight" Value="30"/><Setter Property="ToolTip" Value="{Binding DiagnosticDetails}"/></Style></DataGrid.RowStyle><DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="4,2"/></Style></DataGrid.CellStyle><DataGrid.Columns><DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="82"/><DataGridTextColumn Header="Источник" Binding="{Binding SourceText}" Width="96"/><DataGridTextColumn Header="№" Binding="{Binding SequenceText}" Width="42"/><DataGridTextColumn Header="Событие" Binding="{Binding EventLabel}" Width="*" MinWidth="82"/><DataGridTextColumn Header="Состояние" Binding="{Binding LifecycleLabel}" Width="100"/><DataGridTextColumn Header="Качество" Binding="{Binding QualityTableLabel}" Width="100"/><DataGridTextColumn Header="Очистка" Binding="{Binding CleanupTableLabel}" Width="105"/><DataGridTextColumn Header="Сессия" Binding="{Binding SessionShortId}" Width="65"/></DataGrid.Columns></DataGrid>
            <Border Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,4,0,10"><TextBlock Text="{Binding WorkerSelectedEventDetails}" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="Подробности выбранного события worker"/></Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,8"><StackPanel><TextBlock Text="LOCAL DEMO · локальная D2 модель · не использует Named Pipe" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Text="Локальные сценарии ниже изменяют только состояние ViewModel. Они не являются событиями worker и не подтверждают работу устройств." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal"><Button Content="Предупреждение LOCAL DEMO" Command="{Binding WarningCommand}"/><Button Content="Ошибка LOCAL DEMO" Command="{Binding FailCommand}" Margin="8,0"/><Button Content="Потеря устройства LOCAL DEMO" Command="{Binding DeviceLossCommand}"/><Button Content="Отключить LOCAL DEMO" Command="{Binding DisconnectCommand}" Margin="8,0"/></StackPanel><TextBlock Text="{Binding EmptyEventMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/><ListBox ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventTemplate}" MaxHeight="260" AutomationProperties.Name="Временная шкала локальной демонстрации"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border x:Name="Inspector" Grid.Column="2" Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
        <DockPanel><TextBlock x:Name="InspectorProvenance" DockPanel.Dock="Top" Text="{Binding InspectorProvenanceText}" Foreground="{StaticResource SecondaryBrush}" FontWeight="Bold" Margin="0,0,0,10"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding InspectorTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><ItemsControl x:Name="InspectorSectionList" ItemsSource="{Binding InspectorSections}" ItemTemplate="{StaticResource InspectorSectionTemplate}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource OneBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="16,4" LastChildFill="False"><Button DockPanel.Dock="Right" Content="СТОП WORKER" AutomationProperties.Name="Остановить fake-сессию worker" Style="{StaticResource StopButton}" Width="130" Command="{Binding StopWorkerSessionCommand}" Visibility="{Binding WorkerOperationActive, Converter={StaticResource BoolVisibility}}"/><Button DockPanel.Dock="Right" Content="СТОП LOCAL" AutomationProperties.Name="Остановить локальную demo-сессию" Style="{StaticResource StopButton}" Width="120" Command="{Binding StopCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="WINDOWS DIAGNOSTICS · операции выполняются только по явному действию" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource InverseBoolVisibility}}"/><TextBlock Text="DEVELOPER TOOLS · real Windows diagnostics + synthetic fixtures" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}"/><TextBlock DockPanel.Dock="Right" Text="{Binding WorkerSession.Lifecycle, Converter={StaticResource SessionStateText}, TargetNullValue=Нет fake-сессии}" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Margin="12,0" AutomationProperties.Name="Состояние fake-сессии worker" Visibility="{Binding WorkerStatusVisible, Converter={StaticResource BoolVisibility}}"/><TextBlock DockPanel.Dock="Right" Text="D3-A2A · fake only" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding DeveloperToolsOpen, Converter={StaticResource BoolVisibility}}"/></DockPanel></Border>

    <Border Grid.RowSpan="3" Background="#CC0B1020" Visibility="{Binding ConfirmPending, Converter={StaticResource BoolVisibility}}"><Border Background="{StaticResource OneBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Подтверждение демонстрационной сессии" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ConfirmationText}" Foreground="{StaticResource SecondaryBrush}" Margin="0,12"/><CheckBox Content="Я понимаю, что запускается только демонстрационная симуляция." IsChecked="{Binding ConsentChecked}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Loc Cancel}" Command="{Binding CancelConfirmationCommand}"/><Button Content="{loc:Loc Confirm}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Border>
    <Border Grid.RowSpan="3" Background="#CC0B1020" Visibility="{Binding WorkerConsentPending, Converter={StaticResource BoolVisibility}}"><Border Background="{StaticResource OneBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Подтверждение WORKER FAKE" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkerConsentText}" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Worker выполняет только синтетическую операцию. Нет WASAPI, записи PCM или физической проверки." Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><CheckBox Content="Подтверждаю эти точные настройки fake-сессии." IsChecked="{Binding WorkerConsentChecked}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Loc Cancel}" Command="{Binding CancelWorkerConsentCommand}"/><Button Content="Подтвердить запуск fake" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmWorkerSessionCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Border>
  </Grid>
</Window>
