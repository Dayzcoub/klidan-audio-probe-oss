          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="WindowButtonChrome" Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
