  file(WRITE "${report_path}" "keep-existing-report")
  set(arguments --capture-id endpoint-id-that-must-not-be-opened --test-stream --duration 5 --rate 48000 --channels 2 --format pcm16 --output-json "${report_path}")
  set(expected_exit 2)
  set(expected_text "Refusing to overwrite the existing JSON report")
  set(expected_report_path "${report_path}")
  set(expected_report_contents "keep-existing-report")
else()
  message(FATAL_ERROR "Unknown CLI test case: ${CASE}")
endif()

execute_process(COMMAND "${PROBE}" ${arguments}
  RESULT_VARIABLE actual_exit OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
set(output "${stdout}${stderr}")
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
  message(FATAL_ERROR "${CASE}: expected exit ${expected_exit}, got ${actual_exit}; output: ${output}")
endif()
string(FIND "${output}" "${expected_text}" text_position)
if(text_position EQUAL -1)
  message(FATAL_ERROR "${CASE}: expected diagnostic '${expected_text}'; output: ${output}")
endif()
if(DEFINED expected_text2)
  string(FIND "${output}" "${expected_text2}" text_position)
  if(text_position EQUAL -1)
    message(FATAL_ERROR "${CASE}: expected diagnostic '${expected_text2}'; output: ${output}")
  endif()
endif()
if(DEFINED expected_report_path)
  file(READ "${expected_report_path}" report_contents)
  if(NOT report_contents STREQUAL expected_report_contents)
    message(FATAL_ERROR "${CASE}: existing report was modified")
  endif()
  file(REMOVE "${expected_report_path}")
endif()
