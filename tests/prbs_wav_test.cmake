file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(first "${OUTPUT_DIR}/reference-a.wav")
set(second "${OUTPUT_DIR}/reference-b.wav")
file(REMOVE "${first}" "${second}")
execute_process(COMMAND "${EXPORTER}" "${first}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "first export failed: ${result}")
endif()
execute_process(COMMAND "${EXPORTER}" "${second}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "second export failed: ${result}")
endif()
execute_process(COMMAND "${EXPORTER}" "${first}" RESULT_VARIABLE overwrite_result)
if(overwrite_result EQUAL 0)
  message(FATAL_ERROR "exporter overwrote an existing file")
endif()
execute_process(COMMAND "${EXPORTER}" RESULT_VARIABLE missing_argument_result)
if(NOT missing_argument_result EQUAL 2)
  message(FATAL_ERROR "missing output argument returned ${missing_argument_result}, expected 2")
endif()
execute_process(COMMAND "${EXPORTER}" "${OUTPUT_DIR}/missing-parent/reference.wav" RESULT_VARIABLE bad_path_result)
if(bad_path_result EQUAL 0)
  message(FATAL_ERROR "exporter accepted a path under a nonexistent parent")
endif()
execute_process(COMMAND "${VERIFIER}" "${first}" "${second}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "offline verification failed: ${result}")
endif()
