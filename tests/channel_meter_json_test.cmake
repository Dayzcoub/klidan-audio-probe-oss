execute_process(COMMAND "${TEST_EXE}" --write-json
  RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "meter JSON fixture failed: ${result} ${error}")
endif()
string(JSON version ERROR_VARIABLE parse_error GET "${json}" schemaVersion)
if(parse_error OR NOT version EQUAL 1)
  message(FATAL_ERROR "invalid meter report schema: ${parse_error}")
endif()
string(JSON report_type GET "${json}" reportType)
if(NOT report_type STREQUAL "wasapi-capture-channel-meter")
  message(FATAL_ERROR "unexpected report type: ${report_type}")
endif()
string(JSON report_id GET "${json}" reportId)
string(JSON timestamp GET "${json}" timestampUtc)
if(report_id STREQUAL timestamp OR NOT report_id STREQUAL "12345678-1234-4234-8234-123456789abc")
  message(FATAL_ERROR "report ID must be a separate injected UUID")
endif()
string(JSON topology_channels GET "${json}" topology deviceMixFormat reportedChannelCount)
if(NOT topology_channels EQUAL 2)
  message(FATAL_ERROR "reported mix channel count was lost")
endif()
string(JSON mask_type TYPE "${json}" topology deviceMixFormat channelMask)
if(NOT mask_type STREQUAL "NULL")
  message(FATAL_ERROR "unknown channel mask must remain null")
endif()
string(JSON label_known GET "${json}" topology deviceMixFormat windowsChannelLabels 0 labelKnown)
if(label_known)
  message(FATAL_ERROR "unavailable channel labels must remain unknown")
endif()
string(JSON connector_type TYPE "${json}" topology deviceMixFormat windowsChannelLabels 0 physicalConnector)
if(NOT connector_type STREQUAL "NULL")
  message(FATAL_ERROR "physical connector mapping must remain unknown")
endif()
string(JSON physical_mapping GET "${json}" topology physicalConnectorMappings)
if(NOT physical_mapping STREQUAL "UNKNOWN")
  message(FATAL_ERROR "physical connector mapping was fabricated")
endif()
string(JSON selected_encoding GET "${json}" topology selectedTestFormat encoding)
if(NOT selected_encoding STREQUAL "PCM16")
  message(FATAL_ERROR "selected exact test format is missing")
endif()
string(JSON support_hresult_type TYPE "${json}" observed formatSupportHresult)
if(NOT support_hresult_type STREQUAL "NULL")
  message(FATAL_ERROR "unattempted format support HRESULT must remain null")
endif()
string(JSON meter_status GET "${json}" observed status)
if(NOT meter_status STREQUAL "COMPLETED")
  message(FATAL_ERROR "unexpected meter status: ${meter_status}")
endif()
string(JSON duration_reached GET "${json}" observed durationReached)
string(JSON capture_frames GET "${json}" observed captureFrames)
string(JSON coverage GET "${json}" observed captureFrameCoveragePercent)
string(JSON discontinuities GET "${json}" observed captureDiscontinuities)
string(JSON timestamp_errors GET "${json}" observed captureTimestampErrors)
string(JSON watchdog GET "${json}" observed watchdogTimedOut)
string(JSON cancelled GET "${json}" observed cancelled)
string(JSON stream_status GET "${json}" observed captureStreamStatus)
string(JSON stream_quality GET "${json}" observed captureStreamQuality)
string(JSON meter_analysis GET "${json}" observed meterAnalysisStatus)
if(NOT duration_reached OR NOT capture_frames EQUAL 47520 OR NOT coverage EQUAL 99.0 OR
   NOT discontinuities EQUAL 1 OR NOT timestamp_errors EQUAL 1 OR watchdog OR cancelled OR
   NOT stream_status STREQUAL "STREAM_COMPLETED_WITH_WARNINGS" OR
   NOT stream_quality STREQUAL "ANOMALIES_PRESENT" OR NOT meter_analysis STREQUAL "ANALYZED")
  message(FATAL_ERROR "Capture lifecycle, integrity, quality, and meter evidence disagree")
endif()
string(JSON channels LENGTH "${json}" observed channels)
if(NOT channels EQUAL 1)
  message(FATAL_ERROR "expected one mono channel, got ${channels}")
endif()
if(json MATCHES "\\\"endpointId\\\"|machineId|H:/|C:/Users")
  message(FATAL_ERROR "sanitized meter report contains local identity/path")
endif()
