set(path "${CMAKE_CURRENT_BINARY_DIR}/render-channel-report-test.json")
file(REMOVE "${path}")
execute_process(COMMAND "${TEST_EXE}" --json "${path}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "report fixture generation failed: ${result}")
endif()
file(READ "${path}" json)
file(REMOVE "${path}")
string(JSON schema GET "${json}" schemaVersion)
string(JSON direction GET "${json}" requested direction)
string(JSON channel GET "${json}" requested renderChannelIndex)
string(JSON mix_rate GET "${json}" endpoint deviceMixFormat sampleRateHz)
string(JSON mapping GET "${json}" physicalOutputMapping)
string(JSON lifecycle GET "${json}" observed lifecycleStatus)
string(JSON final_silence GET "${json}" observed finalSilenceSubmitted)
string(JSON actual_rate GET "${json}" observed actualFormat sampleRateHz)
string(JSON certified GET "${json}" evidence certified)
string(JSON endpoint_id TYPE "${json}" endpoint endpointId)
if(NOT schema EQUAL 1 OR NOT direction STREQUAL "RENDER" OR NOT channel EQUAL 2 OR NOT actual_rate EQUAL 48000 OR
   NOT mix_rate EQUAL 44100 OR NOT mapping STREQUAL "UNKNOWN" OR
   NOT lifecycle STREQUAL "STREAM_COMPLETED" OR NOT final_silence OR certified OR NOT endpoint_id STREQUAL "NULL")
  message(FATAL_ERROR "unexpected Render report JSON contract")
endif()
foreach(needle "12345678-1234-4234-8234-123456789abc" "\"endpointId\":null" "\"physicalPlayback\":\"NOT_MEASURED\"")
  string(FIND "${json}" "${needle}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "report missing expected sanitized field: ${needle}")
  endif()
endforeach()
