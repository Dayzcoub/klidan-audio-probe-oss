set(report "${OUTPUT_DIR}/exclusive-format-matrix-test.json")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(REMOVE "${report}")
execute_process(COMMAND "${TEST_EXE}" --write-json "${report}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "JSON fixture export failed: ${result}")
endif()
file(READ "${report}" json)
string(JSON version ERROR_VARIABLE error GET "${json}" schemaVersion)
if(error OR NOT version EQUAL 1)
  message(FATAL_ERROR "invalid schemaVersion: ${error}")
endif()
string(JSON type GET "${json}" reportType)
if(NOT type STREQUAL "wasapi-exclusive-format-matrix")
  message(FATAL_ERROR "unexpected reportType: ${type}")
endif()
string(JSON report_id GET "${json}" reportId)
string(JSON timestamp GET "${json}" timestampUtc)
if(NOT report_id STREQUAL "12345678-1234-4234-8234-123456789abc" OR report_id STREQUAL timestamp)
  message(FATAL_ERROR "reportId must be an independent privacy-safe UUID: ${report_id}")
endif()
string(JSON source GET "${json}" evidence sourceType)
if(NOT source STREQUAL "PASSIVE_QUERY")
  message(FATAL_ERROR "unexpected evidence source: ${source}")
endif()
string(JSON count LENGTH "${json}" candidates)
if(NOT count EQUAL 24)
  message(FATAL_ERROR "expected 24 candidates, got ${count}")
endif()
string(JSON start_type TYPE "${json}" candidates 0 startHr)
if(NOT start_type STREQUAL "NULL")
  message(FATAL_ERROR "passive query must have null startHr, got ${start_type}")
endif()
string(JSON start_called GET "${json}" candidates 0 startCalled)
string(JSON audio_transferred GET "${json}" candidates 0 audioTransferred)
if(start_called OR audio_transferred)
  message(FATAL_ERROR "initialize-only fixture must never start or transfer PCM")
endif()
string(JSON certified GET "${json}" evidence certified)
if(certified)
  message(FATAL_ERROR "diagnostic report must not claim certification")
endif()
if(json MATCHES "endpointId|private|${OUTPUT_DIR}")
  message(FATAL_ERROR "sanitized report contains endpoint or filesystem identity")
endif()
file(REMOVE "${report}")
